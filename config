include /etc/sway/config.d/*

# See ~/.config/fish/config.fish for function
# For monitoring kb changes of layout
#exec_always fish -c kill_monkbd_ps;
exec_always swaync
exec_always fcitx5 -d
exec_always fish -c "kill_monkbd_ps"
exec_always nohup fish -c mon_kbd &

set $color #89DDFF
set $bgcolor #0e1019

bindsym XF86AudioPlay exec fish -c 'playerctl play-pause; sleep 0.1; zenity --notification --text "$(if_playing_else 'Playing' 'Paused'): $(get_song)"; echo -n "p" > /tmp/player.pipe'
bindsym XF86AudioPrev exec fish -c 'playerctl previous; sleep 0.1; zenity --notification --text "\<\<FF: $(get_song)"'
bindsym XF86AudioNext exec fish -c 'playerctl next; sleep 0.1; zenity --notification --text "\>\>FF: $(get_song)"'

bindsym Ctrl+XF86AudioPlay exec fish -c 'zenity --notification --text "PLAYING: $(get_song)"'
bindsym Shift+XF86AudioPrev exec fish -c 'move_backward_music'
bindsym Shift+XF86AudioNext exec fish -c 'move_forward_music'
bindsym Shift+XF86AudioPlay exec fish -c 'playerctl stop; quit_music'

# used by JBL LIVE 460NC
bindsym XF86AudioPause exec fish -c 'zenity --notification --text "P/P: $(get_song)"; echo -n "p" > /tmp/player.pipe'

bindsym Print exec --no-startup-id obs

bindsym KP_Left seat - cursor move -40 0
bindsym KP_Right seat - cursor move 40 0
bindsym KP_Up seat - cursor move 0 -40
bindsym KP_Down seat - cursor move 0 40

bindsym Shift+KP_Left seat - cursor move -10 0
bindsym Shift+KP_Right seat - cursor move 10 0
bindsym Shift+KP_Up seat - cursor move 0 -10
bindsym Shift+KP_Down seat - cursor move 0 10

bindsym KP_Begin seat - cursor press BTN_LEFT; seat - cursor release BTN_LEFT
bindsym Num_Lock seat - cursor set 0 0
bindsym KP_Enter seat - cursor press BTN_RIGHT; seat - cursor release BTN_RIGHT

bindsym KP_Insert seat - cursor press BTN_LEFT
bindsym KP_Delete seat - cursor release BTN_LEFT

gaps inner 30

#gaps inner 50 
#gaps outer 0

#gaps inner 30
#gaps outer 50

client.focused $color $color $bgcolor
client.unfocused #1f2337 $bgcolor #A6ACCD
client.focused_inactive #1f2337 $bgcolor #ffffff 
titlebar_padding 10 4

#set $font pango:DejaVu Sans 13 

set $font pango:DejaVu Sans 11


for_window [title="."] title_format "<b>>%title</b> {*%app_id}"
for_window [app_id="foot"] border pixel 2
for_window [shell="xwayland"] title_format "[XWAYLAND] <b>%title</b>"

set $mod Mod4

font $font 

bindswitch lid:on exec swaymsg output eDP-1 disable
bindswitch lid:off exec swaymsg output eDP-1 enable 

bindsym $mod+Shift+p exec --no-startup-id poweroff

bindsym XF86Calculator exec --no-startup-id gnome-calculator
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +2%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 2%-

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%; exec pactl set-sink-mute @DEFAULT_SINK@ 0
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%; exec pactl set-sink-mute @DEFAULT_SINK@ 0
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

#output * bg /home/ben/azul.jpg fill
#output * bg /home/ben/itsukushima.jpg fill
#output * bg /home/ben/takachiho.jpg fill
#output * bg /home/ben/Downloads/river.jpg fill
#output * bg /home/ben/Downloads/ice.png fill
#output * bg /home/ben/aero.jpg fill
#output * bg /home/ben/sky.jpg fill
#output * bg /home/ben/meadow.jpg fill
output * bg /home/ben/wall.jpg fill


bindsym $mod+Shift+s exec --no-startup-id systemctl suspend
bindsym $mod+Shift+x exec --no-startup-id swaylock \
	--screenshots \
	--indicator-radius 100 \
	--indicator-thickness 7 \
	--effect-blur 7x5 \
	--effect-vignette 0.5:0.5 \
    --font "DejaVu Sans" \
#   --fade-in 2s\
#   --grace 2s

bindsym $mod+Shift+Return exec --no-startup-id qutebrowser 
bindsym $mod+Shift+d exec fish -c set_dark_mode
bindsym $mod+Shift+l exec fish -c set_light_mode

bindsym $mod+c exec swaync-client -C

# Bt headphones
bindsym $mod+b exec bluetoothctl connect '68:59:32:3C:70:54' 
bindsym $mod+Shift+b exec --no-startup-id bluetoothctl disconnect '68:59:32:3C:70:54' 

input type:keyboard {
    xkb_layout us(mac),il
    xkb_options altwin:swap_lalt_lwin,grp:caps_toggle,keypad:pointerkeys,mousekeys:enable,
}

set $left j
set $down k
set $up l
set $right semicolon
set $term foot
set $menu bemenu-run -p "" --fn "DejaVu Sans 14" --nb "$bgcolor" --nf "#a6accd" --ab "$bgcolor" --af "#a6accd" --hb "#89dcff" --hf "$bgcolor" --hp 10 
set $menu2 i3-dmenu-desktop

#exec swayidle -w 
#         timeout 300 'swaylock --font "DejaVu Sans"' \
#         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#         before-sleep 'swaylock --font "DejaVu Sans"'

bindsym $mod+Return exec $term

bindsym $mod+q kill

bindsym $mod+d exec $menu
bindsym XF86Search exec $menu
bindsym $mod+Shift+f exec $menu2

floating_modifier $mod normal

bindsym $mod+Shift+c reload

bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

bindsym $mod+$left focus left
bindsym $mod+$down focus down
#bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
#bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1 
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1 
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen

# FOR REMOTE
bindsym Shift+F5 fullscreen

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode resize {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Right resize shrink width 10px
    bindsym Up resize grow height 10px
    bindsym Down resize shrink height 10px
    bindsym Left resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode resize

bar {
    position top 
    font $font

    status_command while echo "\
    \<\<$(whoami)@$(hostname)\>\> \
    \<KBD $(swaygetkbd)\>\
    \<VOL $(fish -c 'get_volume')\>\
    \<BRT $(fish -c 'brightness')\>\
    \<BAT $(fish -c 'get_battery_thing_no_color')\>\
    \<TIME $(TZ='America/New_York' date -R) $(TZ='America/New_York' date -I)\>\
    "; do sleep 1; done

    colors {
        focused_background $bgcolor 
        focused_workspace $color $color $bgcolor
        statusline #a6accd
        background $bgcolor
        inactive_workspace #1f2337 $bgcolor #a6accd
    }
}

